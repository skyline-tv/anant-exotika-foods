PORT=5000

NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/anant_exotika

JWT_SECRET=replace_with_secure_random_secret

JWT_EXPIRE=7d

# Production: set these to the live HTTPS origins (storefront and admin).
CLIENT_URL=http://localhost:5173

ADMIN_URL=http://localhost:5174

UPLOAD_PATH=uploads

# Used to generate public image URLs without storing localhost in product documents.
# Production: set this to the public API/asset host, e.g. https://api.example.com
PUBLIC_BASE_URL=http://localhost:5000

# Optional: bootstrap the first admin on startup if none exists
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@anantexotika.com
ADMIN_PASSWORD=replace_with_secure_password

# Razorpay (server only — never put the secret in store/admin Vite env files)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# Cash on Delivery (set to false to disable COD globally)
COD_ENABLED=true

# Shiprocket (server only — never expose these to the storefront or admin bundle)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as saved in the Shiprocket panel
SHIPROCKET_PICKUP_LOCATION=
# Origin pincode for serviceability and live rates. SHIPPING_ORIGIN_PIN is used if this is empty.
SHIPROCKET_PICKUP_PIN=
# Same value as the webhook security token configured in the Shiprocket panel
SHIPROCKET_WEBHOOK_TOKEN=
# Optional overrides
# SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
# SHIPROCKET_CHANNEL_ID=
# SHIPROCKET_PACKAGE_LENGTH_CM=10
# SHIPROCKET_PACKAGE_BREADTH_CM=10
# SHIPROCKET_PACKAGE_HEIGHT_CM=10

# Shipping rules (flat charge, and fallback when a live Shiprocket rate is unavailable)
SHIPPING_FREE_THRESHOLD=999
SHIPPING_FALLBACK_RATE=79
SHIPPING_ORIGIN_PIN=

# Resend transactional email (password reset, order updates).
# Keep the API key server-side only — never expose it to the storefront.
RESEND_API_KEY=
# Verified sender, e.g. "Anant Exotika Foods <orders@yourdomain.com>"
EMAIL_FROM=Anant Exotika Foods <onboarding@resend.dev>
